rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Get current user role from users collection, or bootstrap owner
    function isOwnerEmail() {
      return isSignedIn() && request.auth.token.email == 'zakikey.works@gmail.com';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isOwnerEmail() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().account_status == 'APPROVED' &&
        getUserData().role == 'super_admin'
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().account_status == 'APPROVED' &&
        getUserData().role == 'admin'
      );
    }

    function isEditor() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().account_status == 'APPROVED' &&
        getUserData().role == 'editor'
      );
    }

    function isStaff() {
      return isOwnerEmail() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().account_status == 'APPROVED' &&
        getUserData().role in ['super_admin', 'admin', 'editor', 'analyst']
      );
    }

    // Users collection (RBAC, Profiles & Access Requests)
    match /users/{userId} {
      allow read, create, update, delete: if true;
    }

    // Public Showcase: Projects
    match /projects/{projectId} {
      allow read, create, update, delete: if true;
    }

    // Public Showcase: Articles / Insights
    match /articles/{articleId} {
      allow read, create, update, delete: if true;
    }

    // Public Showcase: Agency Members
    match /agency_members/{memberId} {
      allow read, create, update, delete: if true;
    }

    // Public Showcase: Client Logos
    match /client_logos/{logoId} {
      allow read, create, update, delete: if true;
    }

    // Public Showcase: Testimonials
    match /testimonials/{testimonialId} {
      allow read, create, update, delete: if true;
    }

    // Invoices Archive
    match /arsip_invoices/{invoiceId} {
      allow read, create, update, delete: if true;
    }

    // Briefs Archive
    match /arsip_briefs/{briefId} {
      allow read, create, update, delete: if true;
    }

    // Shotlists Archive
    match /arsip_shotlists/{shotlistId} {
      allow read, create, update, delete: if true;
    }

    // Proposals Archive
    match /arsip_proposals/{proposalId} {
      allow read, create, update, delete: if true;
    }

    // Agency Settings (Global metadata & contacts)
    match /agency_settings/{settingId} {
      allow read, create, update, delete: if true;
    }

    // Inquiries (Public Contact Form Submissions)
    match /inquiries/{inquiryId} {
      allow read, create, update, delete: if true;
    }

    // Bug Reports & System Issues
    match /bug_reports/{bugId} {
      allow read, create, update, delete: if true;
    }

    // Production Schedules & Timeline Calendar
    match /production_schedules/{scheduleId} {
      allow read, create, update, delete: if true;
    }

    // Production Shotlists Tasks
    match /shotlists/{shotlistId} {
      allow read, create, update, delete: if true;
    }

    // Creative Moodboard Canvas Items
    match /moodboard_items/{itemId} {
      allow read, create, update, delete: if true;
    }

    // Creative Storyboard Scenes
    match /storyboard_scenes/{sceneId} {
      allow read, create, update, delete: if true;
    }

    // Website & SEO Analytics: Page Views
    match /page_views/{viewId} {
      allow read, create, update, delete: if true;
    }

    // Website & SEO Analytics: Share & Interaction Events
    match /share_events/{eventId} {
      allow read, create, update, delete: if true;
    }
  }
}
